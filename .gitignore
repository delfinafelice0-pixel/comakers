# Basura de macOS
.DS_Store

# Caché local del CLI de Supabase: apunta a la instalación de esta
# máquina (ref del proyecto, URL del pooler, versiones). No es código.
supabase/.temp/

# Nunca
.env
.env.*
supabase/functions/**/*.bak
*.bak-*

# Lo que genera fuente/probar-panel.sh: capturas y paginas de prueba.
_prueba/
_prueba-*.html

# Datos privados: CSV de cobros/pagos del Sheets y cualquier SQL de
# importación con esos datos. El repo es público: NADA de esto se sube.
_datos-privados/

# Salida de fuente/build.py: se genera en fuente/ y se copia a la raíz,
# que es lo servido. Los de fuente/ son build-artifact, no van al repo.
fuente/administracion.html
fuente/interno.html

# node_modules local (acorn/acorn-walk para fuente/revisar-paginas.js).
fuente/node_modules/
